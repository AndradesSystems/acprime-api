generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- ENUMS ---

enum UserType {
  ADMIN
  OPERADOR
  ASSINANTE
}

enum ContractStatus {
  ABERTO
  ATRASADO
  QUITADO
  COBRANCA_PESSOAL
  CALOTEIRO
  NEGOCIADO
}

enum PaymentType {
  JUROS
  PRINCIPAL
  MISTO
  PERSONALIZADO
}

enum ContractPeriodicity {
  DAILY
  WEEKLY
  MONTHLY
  PARCELADO
}

enum TransactionFlow {
  ENTRADA
  SAIDA
}

enum ExpenseType {
  FIXO
  PARCELADO
  VARIAVEL
}

enum TransactionStatus {
  PENDENTE
  CONCLUIDO
  CANCELADO
}

enum InstallmentStatus {
  PENDENTE
  PAGO
}

enum UserStatus {
  ATIVO
  BLOQUEADO
  AGUARDANDO_PAGAMENTO
}

enum UserPlan {
  VAZIO
  STARTER
  PRO
}

enum NegotiationType {
  A_VISTA
  PARCELADO
}

enum NegotiationStatus {
  PENDENTE
  PAGO
  QUEBRADO // Se o cliente atrasar a negociação
}

// --- MODELS ---

model User {
  id               String            @id @default(cuid())
  nome             String
  cpf              String            @unique
  email            String            @unique
  senhaHash        String
  tipo             UserType          @default(OPERADOR)
  status           UserStatus        @default(ATIVO)
  saldoOperacional Decimal           @default(0.00) @db.Decimal(12, 2)
  vencimento       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  clients          Client[]
  contracts        Contract[]
  expenses         PersonalExpense[]
  payments         PaymentHistory[]
  balanceLogs      BalanceLog[]
  plan             UserPlan          @default(VAZIO)

  // Relacionamento adicionado aqui:
  whatsappSession WhatsappSession?

  @@map("users")
}

model WhatsappSession {
  id        String @id @default(cuid())
  pastaAuth String @unique // Ex: "auth_user_1"
  status    String @default("CLOSED") // 🟢 Novo: Para controlar na tela se está OPEN, CLOSED ou CONNECTING

  // 🟢 O campo mágico da Opção A: Guarda todo o cache do Baileys como texto longo no PostgreSQL
  sessionData String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Chave estrangeira e relação com a tabela User
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("whatsapp_sessions")
}

model Client {
  id             String    @id @default(cuid())
  nome           String
  cpf            String    @unique
  telefone       String
  email          String?   @unique
  dataNascimento DateTime?
  endereco       String    @default("Não informado")

  // 🟢 NOVA COLUNA: Array de URLs do Cloudinary
  // Importante: Em bancos já existentes, arrays criados assim iniciam vazios ([]), 
  // o que evita erros de colunas nulas (null) para registros antigos!
  images String[] @default([])

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  contracts Contract[]

  score       String?
  clientScore ClientScore?

  @@index([userId])
  @@map("clients")
}

model ClientScore {
  id              String   @id @default(cuid())
  valor           Int // Pontuação de 0 a 1000
  nivelAnalise    String // Ex: "Análise Consistente", "Risco Crítico", "Excelente Pagador"
  totalEmprestado Decimal  @db.Decimal(12, 2) // Soma do valor principal de todos os contratos
  totalPago       Decimal  @db.Decimal(12, 2) // Tudo que já foi pago (principal + juros + taxas)
  retornoCapital  Decimal  @db.Decimal(5, 2) // % quitado do total (Ex: 84.00)
  noPrazo         Int // Qtd de parcelas ou contratos pagos em dia
  atrasos         Int // Qtd de parcelas ou contratos atrasados
  abertas         Int // Qtd de parcelas/contratos pendentes e sem atraso crônico
  motivos         String[] // Array descritivo: ["Nunca atrasou parcelas diárias (+150)", "Possui contrato como CALOTEIRO (-600)"]

  clientId String @unique // Um score por cliente por varredura
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt

  @@map("client_scores")
}

model Contract {
  id             String               @id @default(cuid())
  valorPrincipal Decimal              @db.Decimal(12, 2)
  valorEmAberto  Decimal              @db.Decimal(12, 2)
  taxa           Decimal              @default(0.00) @db.Decimal(12, 2)
  jurosPercent   Decimal              @db.Decimal(5, 2)
  vencimentoEm   DateTime
  periodicity    ContractPeriodicity
  status         ContractStatus       @default(ABERTO)
  historico      String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  clientId       String
  client         Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId         String
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments       PaymentHistory[]
  installments   ContractInstallment[]

  // Novos Campos para Negociação
  onNegotiation  Boolean              @default(false)
  negotiations   Negotiation[]        // Um contrato pode ter um histórico de tentativas de negociação

  @@index([clientId])
  @@index([userId])
  @@map("contracts")
}

// ============================================================================
model Negotiation {
  id                   String                 @id @default(cuid())
  contractId           String
  contract             Contract               @relation(fields: [contractId], references: [id], onDelete: Cascade)
  
  // ============================================================================
  // FOTOGRAFIA DOS VALORES ORIGINAIS DO CONTRATO NO MOMENTO DO ACORDO
  // ============================================================================
  valorOriginalPrincipal Decimal              @db.Decimal(12, 2) // O valor base do contrato
  valorOriginalEmAberto  Decimal              @db.Decimal(12, 2) // O saldo devedor total acumulado até hoje (com os juros do tempo de atraso)
  valorOriginalTaxa      Decimal              @db.Decimal(12, 2) // A taxa acumulada até o momento
  originalJurosPercent   Decimal              @db.Decimal(5, 2)  // O percentual de juros praticado no contrato original

  // ============================================================================
  // VALORES RESULTANTES DA NEGOCIAÇÃO
  // ============================================================================
  valorDesconto        Decimal                @default(0.00) @db.Decimal(12, 2)
  valorAcordado        Decimal                @db.Decimal(12, 2) // (valorOriginalEmAberto - valorDesconto)
  
  tipo                 NegotiationType        // A_VISTA ou PARCELADO
  status               NegotiationStatus      @default(PENDENTE)
  
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  
  installments         NegotiationInstallment[]

  @@index([contractId])
  @@map("negotiations")
}

// ============================================================================
// NOVA TABELA: Parcelas da Negociação (Seja 1 à vista ou X parceladas)
// ============================================================================
model NegotiationInstallment {
  id             String            @id @default(cuid())
  negotiationId  String
  negotiation    Negotiation       @relation(fields: [negotiationId], references: [id], onDelete: Cascade)
  
  numeroParcela  Int               // Ex: 1 se for à vista, ou 1, 2, 3... se for parcelado
  valorParcela   Decimal           @db.Decimal(12, 2) // Valor de cada parcela calculada
  vencimentoEm   DateTime          // Data de vencimento desta parcela da negociação
  
  // Controle de Pagamento do Acordo
  pagoEm         DateTime?         // Registra o exato momento do pagamento (null se pendente)
  status         NegotiationStatus @default(PENDENTE) // PENDENTE, PAGO, QUEBRADO

  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([negotiationId])
  @@map("negotiation_installments")
}

model ContractInstallment {
  id             String            @id @default(cuid())
  numeroParcela  Int
  valor          Decimal           @db.Decimal(12, 2)
  dataVencimento DateTime
  status         InstallmentStatus @default(PENDENTE)
  dataPagamento  DateTime?
  taxa           Decimal           @default(0.00) @db.Decimal(12, 2)
  contractId     String
  contract       Contract          @relation(fields: [contractId], references: [id], onDelete: Cascade)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([contractId, numeroParcela])
  @@map("contract_installments")
}

model PaymentHistory {
  id              String      @id @default(cuid())
  tipo            PaymentType
  valorPago       Decimal     @db.Decimal(12, 2)
  pagoJuros       Decimal     @db.Decimal(12, 2)
  pagoPrincipal   Decimal     @db.Decimal(12, 2)
  multaCobrada    Decimal     @db.Decimal(12, 2)
  pagoTaxa        Decimal     @default(0.00) @db.Decimal(12, 2)
  dataPagamento   DateTime    @default(now())
  dataReferencia  DateTime?
  observacao      String?
  contractId      String
  contract        Contract    @relation(fields: [contractId], references: [id], onDelete: Cascade)
  createdByUserId String
  createdByUser   User        @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime    @default(now())

  @@index([contractId])
  @@map("payment_histories")
}

model Taxa {
  id        String              @id @default(cuid())
  type      ContractPeriodicity @unique
  value     Decimal             @db.Decimal(12, 2)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@map("taxas")
}

model PersonalExpense {
  id            String            @id @default(cuid())
  descricao     String
  tipo          ExpenseType
  tipo_fluxo    TransactionFlow   @default(SAIDA)
  categoria     String?
  valor         Decimal           @db.Decimal(12, 2)
  pago          Boolean           @default(false)
  status        TransactionStatus @default(PENDENTE)
  dataInicio    DateTime          @default(now())
  parcelasTotal Int?
  parcelaAtual  Int?
  diaDoMes      Int?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("personal_expenses")
}

model BalanceLog {
  id            String          @id @default(cuid())
  tipo          TransactionFlow
  valor         Decimal         @db.Decimal(12, 2)
  descricao     String
  saldoAnterior Decimal         @db.Decimal(12, 2)
  saldoNovo     Decimal         @db.Decimal(12, 2)
  createdAt     DateTime        @default(now())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("balance_logs")
}
