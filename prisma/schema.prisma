generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- ENUMS ---

enum UserType {
  ADMIN
  OPERADOR
  ASSINANTE
}

enum ContractStatus {
  ABERTO
  ATRASADO
  QUITADO
  COBRANCA_PESSOAL
}

enum PaymentType {
  JUROS
  PRINCIPAL
  MISTO
}

enum ContractPeriodicity {
  DAILY
  WEEKLY
  MONTHLY
}

enum TransactionFlow {
  ENTRADA
  SAIDA
}

enum ExpenseType {
  FIXO
  PARCELADO
  VARIAVEL
}

enum TransactionStatus {
  PENDENTE
  CONCLUIDO
  CANCELADO
}

enum InstallmentStatus {
  PENDENTE
  PAGO
}

enum UserStatus {
  ATIVO
  BLOQUEADO
  AGUARDANDO_PAGAMENTO
}

// --- MODELS ---

model User {
  id               String            @id @default(cuid())
  nome             String
  cpf              String            @unique
  email            String            @unique
  senhaHash        String
  tipo             UserType          @default(OPERADOR)
  status           UserStatus        @default(ATIVO)
  saldoOperacional Decimal           @default(0.00) @db.Decimal(12, 2)
  vencimento       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  clients          Client[]
  contracts        Contract[]
  expenses         PersonalExpense[]
  payments         PaymentHistory[]
  balanceLogs      BalanceLog[]

  @@map("users")
}

model Client {
  id             String    @id @default(cuid())
  nome           String
  cpf            String    @unique
  telefone       String
  email          String?   @unique
  dataNascimento DateTime?
  endereco       String    @default("Não informado")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  contracts      Contract[]

  @@index([userId])
  @@map("clients")
}

model Contract {
  id             String              @id @default(cuid())
  valorPrincipal Decimal             @db.Decimal(12, 2)
  valorEmAberto  Decimal             @db.Decimal(12, 2)
  taxa           Decimal             @default(0.00) @db.Decimal(12, 2)
  jurosPercent   Decimal             @db.Decimal(5, 2)
  vencimentoEm   DateTime
  periodicity    ContractPeriodicity
  status         ContractStatus      @default(ABERTO)
  historico      String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  clientId       String
  client         Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId         String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments       PaymentHistory[]
  installments   ContractInstallment[]

  @@index([clientId])
  @@index([userId])
  @@map("contracts")
}

model ContractInstallment {
  id             String            @id @default(cuid())
  numeroParcela  Int
  valor          Decimal           @db.Decimal(12, 2)
  dataVencimento DateTime
  status         InstallmentStatus @default(PENDENTE)
  dataPagamento  DateTime?
  taxa           Decimal           @default(0.00) @db.Decimal(12, 2)
  contractId     String
  contract       Contract          @relation(fields: [contractId], references: [id], onDelete: Cascade)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([contractId, numeroParcela])
  @@map("contract_installments")
}

model PaymentHistory {
  id              String      @id @default(cuid())
  tipo            PaymentType
  valorPago       Decimal     @db.Decimal(12, 2)
  pagoJuros       Decimal     @db.Decimal(12, 2)
  pagoPrincipal   Decimal     @db.Decimal(12, 2)
  multaCobrada    Decimal     @db.Decimal(12, 2)
  pagoTaxa        Decimal     @default(0.00) @db.Decimal(12, 2)
  dataPagamento   DateTime    @default(now())
  dataReferencia  DateTime?
  observacao      String?
  contractId      String
  contract        Contract    @relation(fields: [contractId], references: [id], onDelete: Cascade)
  createdByUserId String
  createdByUser   User        @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime    @default(now())

  @@index([contractId])
  @@map("payment_histories")
}

model Taxa {
  id        String              @id @default(cuid())
  type      ContractPeriodicity @unique
  value     Decimal             @db.Decimal(12, 2)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@map("taxas")
}

model PersonalExpense {
  id            String            @id @default(cuid())
  descricao     String
  tipo          ExpenseType
  tipo_fluxo    TransactionFlow   @default(SAIDA)
  categoria     String?
  valor         Decimal           @db.Decimal(12, 2)
  pago          Boolean           @default(false)
  status        TransactionStatus @default(PENDENTE)
  dataInicio    DateTime          @default(now())
  parcelasTotal Int?
  parcelaAtual  Int?
  diaDoMes      Int?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("personal_expenses")
}

model BalanceLog {
  id            String          @id @default(cuid())
  tipo          TransactionFlow
  valor         Decimal         @db.Decimal(12, 2)
  descricao     String
  saldoAnterior Decimal         @db.Decimal(12, 2)
  saldoNovo     Decimal         @db.Decimal(12, 2)
  createdAt     DateTime        @default(now())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("balance_logs")
}